<Window x:Class="NiderTextSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nider Text" Width="520" Height="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Foreground="#EEF3F6"
        Icon="pack://application:,,,/logo.png">
    <Window.Resources>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D6DEE3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="46" Height="26" CornerRadius="13"
                                    Background="#2C323A" BorderBrush="#3F4751" BorderThickness="1">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#9AA6AF"
                                         HorizontalAlignment="Left" Margin="4,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#EEF3F6"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#0B0D10"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#0B0D10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#EEF3F6" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="#D6DEE3"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#3F4751" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3038"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2B3037" Offset="0"/>
                <GradientStop Color="#0B0D10" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Margin="40,34,40,24">
            <Image Source="{StaticResource NiderLogo}" Width="120" Height="120" HorizontalAlignment="Left"/>
            <TextBlock Text="Nider Text" FontSize="40" FontWeight="SemiBold" Margin="0,14,0,0"/>
            <TextBlock Text="Editor de texto e diagramação de livros" FontSize="16" Foreground="#9AA6AF" Margin="0,4,0,0"/>
            <TextBlock Text="Escreva, formate e diagrame livros em PDF pronto para a gráfica, direto do seu computador."
                       FontSize="14" Foreground="#9AA6AF" TextWrapping="Wrap" Margin="0,18,0,0"/>

            <TextBlock x:Name="InfoText" FontSize="13" Foreground="#6B7680" Margin="0,16,0,0" Visibility="Collapsed"/>

            <StackPanel x:Name="Options" Margin="0,26,0,0">
                <CheckBox x:Name="DesktopBox" Style="{StaticResource Switch}" IsChecked="True"
                          Content="Criar atalho na área de trabalho"/>
                <CheckBox x:Name="OpenBox" Style="{StaticResource Switch}" IsChecked="True"
                          Content="Abrir quando terminar"/>
            </StackPanel>

            <Button x:Name="PrimaryBtn" Style="{StaticResource Primary}" Content="Instalar" Margin="0,8,0,10" Click="Primary_Click"/>
            <Button x:Name="PortableBtn" Style="{StaticResource Ghost}" Content="Usar sem instalar" Click="Portable_Click"/>

            <ProgressBar x:Name="Progress" Height="4" IsIndeterminate="True" Visibility="Collapsed"
                         Foreground="#EEF3F6" Background="#2C323A" BorderThickness="0" Margin="0,16,0,0"/>
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="#D6DEE3" TextWrapping="Wrap" Margin="0,12,0,0"/>

            <TextBlock FontSize="12" Foreground="#6B7680" Margin="0,22,0,0">
                <Hyperlink NavigateUri="https://nider.com.br" RequestNavigate="Link_Navigate" Foreground="#9AA6AF">nider.com.br</Hyperlink>
                <Run Text="  ·  "/>
                <Hyperlink NavigateUri="mailto:nider@nider.com.br" RequestNavigate="Link_Navigate" Foreground="#9AA6AF">nider@nider.com.br</Hyperlink>
            </TextBlock>
            <TextBlock Text="Nider Company  ·  Willian Dias" FontSize="11" Foreground="#6B7680" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</Window>
